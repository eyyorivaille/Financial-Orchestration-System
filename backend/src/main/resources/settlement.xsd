<?xml version="1.0" encoding="UTF-8"?>
<!--
  Contract for the fake "legacy core banking" settlement confirmation service
  (com.financial.project.settlement.internal.soap). Served as a WSDL via
  shared.WebServiceConfig; SettlementConfirmationRequest/Response are hand-written
  JAXB classes that mirror this schema exactly.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://financial.project.com/settlement"
           targetNamespace="http://financial.project.com/settlement"
           elementFormDefault="qualified">

    <xs:element name="settlementConfirmationRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="paymentId" type="xs:string"/>
                <xs:element name="customerId" type="xs:string"/>
                <xs:element name="amountMinorUnits" type="xs:long"/>
                <xs:element name="currency" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="settlementConfirmationResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="referenceId" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>
