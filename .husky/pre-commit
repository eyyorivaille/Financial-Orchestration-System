npx lint-staged

if git diff --cached --name-only --diff-filter=ACM | grep -q '^backend/.*\.java$'; then
  echo "Formatting backend (Spotless)..."
  (cd backend && ./mvnw -q spotless:apply) || exit 1
  git diff --cached --name-only --diff-filter=ACM | grep '^backend/.*\.java$' | xargs -r git add
fi
